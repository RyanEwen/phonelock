<?xml version="1.0" encoding="utf-8"?>
<!-- GitHub build only: this app updates itself from the public releases (AppUpdate). Play forbids an app
     updating itself outside the store, so the Play build has neither the permission nor the receiver. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <receiver android:name=".AppUpdate$Result" android:exported="false" />
    </application>
</manifest>
